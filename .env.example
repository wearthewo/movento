# --- Production overlay (docker-compose.prod.yml) ---
DOMAIN=movento.example.com
IMAGE_REGISTRY=ghcr.io/wearthewo/movento
IMAGE_TAG=latest
COOKIE_SECURE=true

# --- Host ports (change any that are already in use on your machine) ---
