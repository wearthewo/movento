# Public entry point. Only the web app and the Stripe webhook are reachable from the internet;
# every other API call goes browser -> Next.js BFF -> api-gateway over the private Docker network.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	handle /api/v1/webhooks/stripe {
		reverse_proxy api-gateway:8080
	}

	handle {
		reverse_proxy web:3000
	}
}
